# Root allowlist: keep code, configuration, and documentation files
/*
!/*/
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.dockerignore
!/*.py
!/*.sh
!/*.md
!/*.txt
!/*.toml
!/*.yaml
!/*.yml
!/*.ini
!/*.cfg
!/*.cff
!/LICENSE*
!/Makefile
!/Dockerfile

# Datasets and generated artifacts
/data/
/datasets/
/newoutput/
/outputs/
/results/
/run_logs/
/logs/
/artifacts/
/checkpoints/
/models/
/wandb/
/runs/
/cache/
/.cache/
/code/

# Dataset tables and experiment outputs
*.jsonl
*.csv
*.tsv
/*.json

# Model weights, databases, tensors, and serialized data
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.gguf
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.arrow
*.parquet
*.feather
*.db
*.sqlite
*.sqlite3

# Archives and large media
*.zip
*.tar
*.tar.gz
*.tar.zst
*.tgz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.mp4
*.avi
*.mov
*.mkv
*.wav
*.mp3
*.flac

# Logs and temporary outputs
*.log
nohup.out
*.out
*.tmp
*.temp
*.swp
*.swo

# Python caches and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# IDE and operating-system noise
.idea/
.DS_Store
Thumbs.db



